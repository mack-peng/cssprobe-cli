{
  "name": "cssprobe-cli",
  "version": "0.2.18",
  "description": "Runtime CSS probe — inspect layout, colors, backgrounds, fonts and more in a live browser. AI agents and shell automation.",
  "keywords": [
    "css",
    "inspect",
    "layout",
    "dom",
    "forensics",
    "debug",
    "browser",
    "agent",
    "automation"
  ],
  "homepage": "https://github.com/mack-peng/cssprobe-cli#readme",
  "repository": "github:mack-peng/cssprobe-cli",
  "license": "MIT",
  "author": "strikingly",
  "main": "dist/index.js",
  "bin": {
    "cssprobe-cli": "./bin/cssprobe-cli.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
